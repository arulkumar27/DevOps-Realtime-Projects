project_name = "project03-multi-region-dr"
environment  = "production"
aws_region   = "ap-south-1"

vpc_cidr          = "10.10.0.0/16"
availability_zones = ["ap-south-1a", "ap-south-1b"]

public_subnet_cidrs      = ["10.10.1.0/24", "10.10.2.0/24"]
private_app_subnet_cidrs = ["10.10.11.0/24", "10.10.12.0/24"]
private_db_subnet_cidrs  = ["10.10.21.0/24", "10.10.22.0/24"]

ssh_allowed_cidr = "0.0.0.0/32"

instance_type        = "t3.micro"
key_name             = "REPLACE_WITH_PRIMARY_KEY_PAIR"
asg_minimum_size     = 1
asg_desired_capacity = 1
asg_maximum_size     = 1

db_instance_class           = "db.t3.micro"
db_allocated_storage        = 20
db_name                     = "drplatform"
db_username                 = "dbadmin"
db_backup_retention_period  = 1

dr_region = "ap-south-2"

backup_schedule       = "cron(0 20 * * ? *)"
backup_retention_days = 1

ec2_cpu_alarm_threshold = 80
rds_cpu_alarm_threshold = 80

controller_instance_type = "t3.micro"