pipeline {
    agent any

    stages {
        stage('Backend Dependencies') {
            steps {
                dir('Project-04-FarmDirect-Secure-DevSecOps-Platform/app/backend') {
                    bat 'npm install'
                }
            }
        }

        stage('Backend Tests') {
            steps {
                dir('Project-04-FarmDirect-Secure-DevSecOps-Platform/app/backend') {
                    bat 'npm test'
                }
            }
        }

        stage('Frontend Production Build') {
            steps {
                dir('Project-04-FarmDirect-Secure-DevSecOps-Platform/app/frontend') {
                    bat 'npm install'
                    bat 'npm run build'
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                bat '"C:/Users/Madhankumar/AppData/Local/Programs/DockerDesktop/resources/bin/docker-compose.exe" -f Project-04-FarmDirect-Secure-DevSecOps-Platform/docker/docker-compose.yml build'
            }
        }

        stage('Deploy to Development') {
            steps {
                dir('Project-04-FarmDirect-Secure-DevSecOps-Platform') {
                    bat 'copy /Y docker\\.env.example docker\\.env'
                    bat 'copy /Y app\\backend\\.env.example app\\backend\\.env'
                    bat '"C:/Users/Madhankumar/AppData/Local/Programs/DockerDesktop/resources/bin/docker-compose.exe" -f docker/docker-compose.yml up -d'
                }
            }
        }
    }

    post {
        success {
            echo 'FarmDirect CI and Development deployment completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the failed stage logs.'
        }
    }
}