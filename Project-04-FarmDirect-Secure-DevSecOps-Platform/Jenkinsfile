pipeline {
    agent any

    stages {
        stage('Backend Dependencies') {
            steps {
                dir('Project-04-FarmDirect-Secure-DevSecOps-Platform/app/backend') {
                    bat 'npm install'
                }
            }
        }

        stage('Backend Tests') {
            steps {
                dir('Project-04-FarmDirect-Secure-DevSecOps-Platform/app/backend') {
                    bat 'npm test'
                }
            }
        }

        stage('Frontend Production Build') {
            steps {
                dir('Project-04-FarmDirect-Secure-DevSecOps-Platform/app/frontend') {
                    bat 'npm install'
                    bat 'npm run build'
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                bat '"C:/Users/Madhankumar/AppData/Local/Programs/DockerDesktop/resources/bin/docker.exe" compose -f Project-04-FarmDirect-Secure-DevSecOps-Platform/docker/docker-compose.yml build'
            }
        }
    }

    post {
        success {
            echo 'FarmDirect CI pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the failed stage logs.'
        }
    }
}