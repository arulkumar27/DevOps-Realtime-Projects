pipeline {
    agent any

    stages {
        stage('Backend Dependencies') {
            steps {
                dir('app/backend') {
                }
            }
        }

        stage('Backend Tests') {
            steps {
                dir('app/backend') {
                }
            }
        }

        stage('Frontend Production Build') {
            steps {
                dir('app/frontend') {
                    bat 'npm ci'
                    bat 'npm run build'
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                bat 'docker compose -f docker/docker-compose.yml build'
            }
        }
    }

    post {
        success {
            echo 'FarmDirect CI pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the failed stage logs.'
        }
    }
}