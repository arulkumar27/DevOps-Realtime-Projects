pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    environment {
        APP_NAME = 'product-service'
        IMAGE = "product-service:${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git log -1 --oneline'
            }
        }

        stage('Build and Unit Test') {
            steps {
                sh 'mvn -B clean verify'
            }
            post {
                always {
                    junit testResults: 'target/surefire-reports/*.xml', allowEmptyResults: false
                }
            }
        }

        stage('Package') {
            steps {
                sh 'mvn -B package -DskipTests'
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build --pull -t "$IMAGE" .'
            }
        }

        stage('Security Scan') {
            steps {
                sh '''
                  trivy image --exit-code 0 --severity LOW,MEDIUM "$IMAGE"
                  trivy image --exit-code 1 --severity HIGH,CRITICAL --ignore-unfixed "$IMAGE"
                '''
            }
        }

        stage('Deploy Blue/Green') {
            when {
                branch 'main'
            }
            steps {
                sh 'chmod +x deploy/scripts/blue-green-deploy.sh'
                sh 'deploy/scripts/blue-green-deploy.sh "$IMAGE"'
            }
        }

        stage('Smoke Test') {
            when {
                branch 'main'
            }
            steps {
                sh '''
                  curl --fail --silent http://127.0.0.1/actuator/health | grep '"status":"UP"'
                  curl --fail --silent http://127.0.0.1/api/products | grep 'Cloud Course'
                '''
            }
        }
    }

    post {
        success {
            echo "CI/CD successful. Build ${BUILD_NUMBER} is live."
        }
        failure {
            echo "Pipeline failed at ${env.STAGE_NAME}. Check the stage logs."
        }
        always {
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}
