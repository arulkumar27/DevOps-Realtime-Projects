aws_region   = "ap-south-1"
project_name = "enterprise-iac-platform"
environment  = "dev"

vpc_cidr = "10.10.0.0/16"

availability_zones = [
  "ap-south-1a",
  "ap-south-1b"
]

public_subnet_cidrs = [
  "10.10.1.0/24",
  "10.10.2.0/24"
]

private_subnet_cidrs = [
  "10.10.11.0/24",
  "10.10.12.0/24"
]

listener_port    = 80
application_port = 8080

allowed_ingress_cidrs = [
  "0.0.0.0/0"
]

certificate_arn            = null
enable_deletion_protection = false

instance_type    = "t3.micro"
root_volume_size = 8

minimum_capacity = 1
desired_capacity = 1
maximum_capacity = 2

health_check_grace_period = 180

notification_emails = []

common_tags = {
  Owner      = "Arul-Kumar"
  Repository = "DevOps-Realtime-Projects"
  ManagedBy  = "Terraform"
}