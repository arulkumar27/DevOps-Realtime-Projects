aws_region   = "ap-south-1"
project_name = "enterprise-iac-platform"
environment  = "production"

vpc_cidr = "10.30.0.0/16"

availability_zones = [
  "ap-south-1a",
  "ap-south-1b"
]

public_subnet_cidrs = [
  "10.30.1.0/24",
  "10.30.2.0/24"
]

private_subnet_cidrs = [
  "10.30.11.0/24",
  "10.30.12.0/24"
]

listener_port    = 443
application_port = 8080

allowed_ingress_cidrs = [
  "0.0.0.0/0"
]

# The production ACM ARN will be supplied securely by Jenkins.
# It is not stored inside this file.
enable_deletion_protection = true

instance_type    = "t3.micro"
root_volume_size = 12

minimum_capacity = 2
desired_capacity = 2
maximum_capacity = 4

health_check_grace_period = 180

notification_emails = []

common_tags = {
  Owner       = "Arul-Kumar"
  Repository  = "DevOps-Realtime-Projects"
  ManagedBy   = "Terraform"
  Criticality = "Production"
}