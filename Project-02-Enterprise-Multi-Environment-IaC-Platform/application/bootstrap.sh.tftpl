#!/usr/bin/env bash

set -euo pipefail

APPLICATION_USER="enterpriseapp"
APPLICATION_DIRECTORY="/opt/enterprise-app"
SERVICE_FILE="/etc/systemd/system/enterprise-app.service"

if ! command -v python3 >/dev/null 2>&1; then
  echo "Python 3 is required by the development application image."
  exit 1
fi

if ! id "$APPLICATION_USER" >/dev/null 2>&1; then
  useradd \
    --system \
    --home-dir "$APPLICATION_DIRECTORY" \
    --shell /usr/sbin/nologin \
    "$APPLICATION_USER"
fi

install \
  --directory \
  --owner "$APPLICATION_USER" \
  --group "$APPLICATION_USER" \
  --mode 0755 \
  "$APPLICATION_DIRECTORY"

echo "${index_content}" |
  base64 --decode > "$APPLICATION_DIRECTORY/index.html"

echo "${health_content}" |
  base64 --decode > "$APPLICATION_DIRECTORY/health.html"

chown -R "$APPLICATION_USER:$APPLICATION_USER" "$APPLICATION_DIRECTORY"
chmod 0644 "$APPLICATION_DIRECTORY/index.html"
chmod 0644 "$APPLICATION_DIRECTORY/health.html"

cat > "$SERVICE_FILE" <<SERVICE
[Unit]
Description=Enterprise IaC demonstration application
After=network.target

[Service]
Type=simple
User=$APPLICATION_USER
Group=$APPLICATION_USER
WorkingDirectory=$APPLICATION_DIRECTORY
ExecStart=/usr/bin/python3 -m http.server ${application_port} --directory $APPLICATION_DIRECTORY
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=$APPLICATION_DIRECTORY

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable enterprise-app.service
systemctl restart enterprise-app.service